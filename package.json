{
  "name": "isandre-storefront",
  "version": "1.0.0",
  "description": "International storefront for ISANDRE.",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:guide:pdf": ".venv-brand/bin/python brand/tools/render_brand_guide.py",
    "brand:verify": "tsx scripts/verify-brand-system.ts",
    "content:verify": "tsx scripts/verify-content-system.ts",
    "industrial:verify": "tsx scripts/verify-industrial-system.ts",
    "media:pilots:verify": "tsx scripts/verify-visual-pilots.ts",
    "media:technical": "node scripts/build-isandre-technical-media.mjs",
    "media:build": "node scripts/build-isandre-media.mjs",
    "media:preproduction": "node scripts/build-preproduction-media.mjs",
    "media:preproduction:verify": "tsx scripts/verify-preproduction-media.ts",
    "media:qa:boards": "node scripts/build-a7-qa-boards.mjs",
    "media:verify": "tsx scripts/verify-media-system.ts",
    "assets:storefront": "npm run media:build && npm run media:preproduction && npm run media:verify && npm run media:preproduction:verify",
    "projection:kits": "node scripts/generate-projection-reference-kits.mjs",
    "geometry:import": "tsx scripts/import-veille-geometry.ts",
    "geometry:import:verify": "tsx scripts/verify-geometry-import.ts",
    "projection:verify": "tsx scripts/verify-projection-engine.ts",
    "projection:contract:verify": "tsx scripts/verify-projection-contract.ts",
    "projection:errors:verify": "tsx scripts/verify-projection-errors.ts",
    "projection:openai:verify": "tsx scripts/verify-openai-projection-access.ts",
    "markets:verify": "tsx scripts/verify-markets.ts",
    "checkout:verify": "tsx scripts/verify-checkout-contract.ts",
    "orders:verify": "tsx scripts/verify-order-service.ts",
    "service-requests:verify": "tsx scripts/verify-service-requests.ts",
    "service-requests:export": "tsx scripts/export-service-requests.ts",
    "passports:verify": "tsx scripts/verify-passports.ts",
    "measurement:verify": "tsx scripts/verify-measurement.ts",
    "seo:verify": "tsx scripts/verify-seo-commerce.ts",
    "launch:pdf": ".venv-brand/bin/python scripts/build-launch-pdfs.py",
    "technical:pdf": ".venv-brand/bin/python scripts/build-technical-sheets.py",
    "launch:verify": "tsx scripts/verify-launch-kit.ts",
    "accessibility:verify": "tsx scripts/verify-accessibility.ts",
    "performance:verify": "node scripts/verify-performance.mjs",
    "qa:screenshots": "node scripts/capture-qa.mjs",
    "browser:verify": "node scripts/verify-browser-local.mjs",
    "deployment:verify": "node scripts/verify-deployment-readiness.mjs",
    "stripe:tax:configure": "tsx scripts/configure-stripe-tax.ts",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "security:verify": "tsx scripts/verify-security-boundaries.ts",
    "completion:verify": "node scripts/verify-completion-audit.mjs",
    "verify:all": "node scripts/verify-all-local.mjs",
    "dev": "next dev",
    "build": "node scripts/clean-next-build.mjs .next && next build --webpack",
    "build:qa": "node scripts/clean-next-build.mjs .next-qa && NEXT_DIST_DIR=.next-qa next build --webpack",
    "start": "next start",
    "start:qa": "NEXT_DIST_DIR=.next-qa next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "shadcn": "^4.16.1",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.19",
    "sharp": "$sharp"
  }
}
